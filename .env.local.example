# --- AI vision model (Vercel AI Gateway) ---
# Get a key from your Vercel dashboard → AI Gateway. Provided automatically when deployed on Vercel.
AI_GATEWAY_API_KEY=

# --- eBay market data (optional but recommended) ---
# Create an app at https://developer.ebay.com → your keysets. Use the PRODUCTION keys.
# Without these, prices fall back to AI estimates.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# --- Similar-listing web search (Exa via Vercel Marketplace) ---
# Provisioned by `vercel integration add exa/exa-search-api`; pull with `vercel env pull`.
# Without this, the "similar listings on the web" section is skipped.
EXA_API_KEY=
